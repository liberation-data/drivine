# The datasources Drivine's tests run against. Each one gets a test container (Docker must be running), whose host,
# port and credentials replace those below. Overrides go in .env.test.local, which git ignores. See TEST_CONTAINERS.md.
#
# To work against an instance of your own, set USE_LOCAL_<TYPE>=true: that type then starts no container and its
# datasources use the settings here (or in .env.test.local) as they are.
#
#   USE_LOCAL_NEO4J  USE_LOCAL_MEMGRAPH  USE_LOCAL_FALKORDB  USE_LOCAL_POSTGRES  USE_LOCAL_ORACLE
#
# Oracle runs only with ORACLE_TESTS=true: its image is large and the database wants two gigabytes of memory.

DRIVINE_LOG_LEVEL=ERROR

# The tests run on the latest Neo4j, as drivine4j's and drivine-python's do, so a Neo4j release that changes what
# Drivine reads or writes shows up at once. Drivine's own default for your tests, from @liberation-data/drivine/testing,
# stays neo4j:5.26-community.
NEO4J_TEST_IMAGE=neo4j:latest

DATABASE_TYPE=NEO4J
DATABASE_HOST=localhost
DATABASE_PORT=7687
DATABASE_USER=neo4j
DATABASE_PASSWORD=drivine-test

# The repository and end-to-end tests' second database: the same Neo4j as the default, so the same container.
TRAFFIC_DATABASE_TYPE=NEO4J
TRAFFIC_DATABASE_HOST=localhost
TRAFFIC_DATABASE_PORT=7687
TRAFFIC_DATABASE_USER=neo4j
TRAFFIC_DATABASE_PASSWORD=drivine-test

MEMGRAPH_DATABASE_TYPE=MEMGRAPH
MEMGRAPH_DATABASE_HOST=localhost
MEMGRAPH_DATABASE_PORT=7688

FALKORDB_DATABASE_TYPE=FALKORDB
FALKORDB_DATABASE_HOST=localhost
FALKORDB_DATABASE_PORT=6379
FALKORDB_DATABASE_NAME=drivine_test

POSTGRES_DATABASE_TYPE=POSTGRES
POSTGRES_DATABASE_HOST=localhost
POSTGRES_DATABASE_PORT=5432
POSTGRES_DATABASE_NAME=drivine
POSTGRES_DATABASE_USER=drivine
POSTGRES_DATABASE_PASSWORD=drivine-test

ORACLE_DATABASE_TYPE=ORACLE
ORACLE_DATABASE_HOST=localhost
ORACLE_DATABASE_PORT=1521
ORACLE_DATABASE_NAME=FREEPDB1
ORACLE_DATABASE_USER=drivine
ORACLE_DATABASE_PASSWORD=drivine-test
