---
/**
 * The Cypher playground: Drivine for TypeScript running in the page, on SQLite's wasm build, with a small movies graph.
 * A query is compiled to SQL by the shared Cypher compiler and run on SQLite, in the browser, with nothing sent to a
 * server. The engine is public/playground/engine.mjs, bundled by scripts/bundle-playground.mjs. It starts as the page
 * loads, and runs the query in the box.
 */
import { EXAMPLES } from '../playground/movies';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="pg" data-engine={`${base}playground/engine.mjs`} data-examples={JSON.stringify(EXAMPLES.map((e) => e.cypher))}>
    <div class="pg-examples" role="group" aria-label="Example queries">
        {
            EXAMPLES.map((example, i) => (
                <button type="button" class="pg-example" data-index={i}>
                    {example.label}
                </button>
            ))
        }
    </div>
    <label class="pg-label" for="pg-cypher">Cypher</label>
    <textarea id="pg-cypher" class="pg-cypher" rows="7" spellcheck="false" autocapitalize="off">{EXAMPLES[0].cypher}</textarea>
    <div class="pg-actions">
        <button type="button" class="pg-run" disabled>Loading…</button>
        <button type="button" class="pg-reset" disabled>Reset</button>
        <span class="pg-status" role="status" aria-live="polite"></span>
    </div>
    <div class="pg-panes">
        <section class="pg-pane" aria-labelledby="pg-results-title">
            <h2 id="pg-results-title" class="pg-pane-title">Results</h2>
            <div class="pg-results"></div>
        </section>
        <section class="pg-pane" aria-labelledby="pg-sql-title">
            <h2 id="pg-sql-title" class="pg-pane-title">Compiled SQL (SQLite)</h2>
            <pre class="pg-sql"><code></code></pre>
        </section>
    </div>
</div>

<script>
    type Outcome = { rows?: Record<string, unknown>[]; sql?: string; error?: string; millis: number };
    type Playground = { run(cypher: string): Promise<Outcome>; reset(): Promise<void> };

    /** A value as a cell shows it: text as it is, anything else as JSON. */
    function shown(value: unknown): string {
        if (typeof value === 'string') return value;
        return JSON.stringify(value, (_key, v) => (typeof v === 'bigint' ? v.toString() : v)) ?? 'null';
    }

    /** The rows as a table, a column for each of their columns. */
    function table(rows: Record<string, unknown>[]): HTMLElement {
        if (rows.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'pg-empty';
            empty.textContent = 'No rows.';
            return empty;
        }
        const columns = [...new Set(rows.flatMap((row) => Object.keys(row)))];
        const element = document.createElement('table');
        const head = element.createTHead().insertRow();
        for (const column of columns) {
            const th = document.createElement('th');
            th.textContent = column;
            head.appendChild(th);
        }
        const body = element.createTBody();
        for (const row of rows) {
            const tr = body.insertRow();
            for (const column of columns) {
                tr.insertCell().textContent = shown(row[column]);
            }
        }
        return element;
    }

    /** Wires the playground `root` up, and starts its engine. */
    function playground(root: HTMLElement): void {
        const cypher = root.querySelector<HTMLTextAreaElement>('.pg-cypher')!;
        const runButton = root.querySelector<HTMLButtonElement>('.pg-run')!;
        const resetButton = root.querySelector<HTMLButtonElement>('.pg-reset')!;
        const status = root.querySelector<HTMLElement>('.pg-status')!;
        const results = root.querySelector<HTMLElement>('.pg-results')!;
        const sql = root.querySelector<HTMLElement>('.pg-sql code')!;
        const examples: string[] = JSON.parse(root.dataset.examples ?? '[]');

        function show(outcome: Outcome): void {
            sql.textContent = outcome.sql ?? '';
            results.replaceChildren();
            if (outcome.error !== undefined) {
                const error = document.createElement('p');
                error.className = 'pg-error';
                error.textContent = outcome.error;
                results.appendChild(error);
                status.textContent = outcome.sql ? 'Failed.' : 'Refused.';
                return;
            }
            const rows = outcome.rows ?? [];
            results.appendChild(table(rows));
            status.textContent = `${rows.length} ${rows.length === 1 ? 'row' : 'rows'} in ${outcome.millis.toFixed(1)} ms`;
        }

        // The engine, once asked for: started once, however many ask.
        let engine: Promise<Playground | undefined> | undefined;
        let ready = false;
        let tries = 0;
        const started = (): Promise<Playground | undefined> =>
            (engine ??= (async () => {
                runButton.disabled = true;
                runButton.textContent = 'Loading…';
                status.textContent = '';
                try {
                    // A retry asks afresh: the browser keeps a module that failed to load as failed.
                    const url = root.dataset.engine! + (tries++ ? `?try=${tries}` : '');
                    const module = await import(/* @vite-ignore */ url);
                    const it: Playground = await module.start();
                    ready = true;
                    status.textContent = 'Ready.';
                    return it;
                } catch (e) {
                    status.textContent = `The playground couldn't start: ${(e as Error)?.message ?? e}`;
                    engine = undefined; // so Run tries again
                    return undefined;
                } finally {
                    runButton.disabled = false;
                    runButton.textContent = 'Run';
                }
            })());

        let busy = false;
        const busyWhile = async (work: (it: Playground) => Promise<void>) => {
            if (busy) return;
            busy = true;
            try {
                const it = await started();
                if (!it) return;
                runButton.disabled = resetButton.disabled = true;
                await work(it);
            } catch (e) {
                // A run reports its own failures; this is for one that never got that far, such as a reset.
                status.textContent = `Something went wrong: ${(e as Error)?.message ?? e}`;
            } finally {
                busy = false;
                runButton.disabled = false;
                resetButton.disabled = !ready;
            }
        };
        const run = () => busyWhile(async (it) => show(await it.run(cypher.value)));
        runButton.addEventListener('click', run);
        resetButton.addEventListener('click', () =>
            busyWhile(async (it) => {
                await it.reset();
                status.textContent = 'The graph is back as it started.';
            })
        );
        cypher.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
                event.preventDefault();
                run();
            }
        });
        root.querySelectorAll<HTMLButtonElement>('.pg-example').forEach((button) =>
            button.addEventListener('click', () => {
                // While a run is out, as Run does: the box keeps the query whose results are shown. While the engine
                // loads, nothing is shown yet, so the example goes in the box for the run waiting on it.
                if (busy && ready) return;
                cypher.value = examples[Number(button.dataset.index)];
                if (!busy) run();
            })
        );

        run();
    }

    document.querySelectorAll<HTMLElement>('.pg').forEach(playground);
</script>

<style>
    /*
     * The colours and type are Starlight's, from the /playground page; the fallbacks are for a page that isn't Starlight's.
     */
    .pg {
        --pg-text: var(--sl-color-text, var(--ink, #0b2530));
        --pg-muted: var(--sl-color-gray-3, var(--muted, #3e5a64));
        --pg-label: var(--sl-color-gray-2, var(--muted, #3e5a64));
        --pg-border: var(--sl-color-gray-5, var(--line, #d5e3e6));
        --pg-button: var(--sl-color-bg-nav, #fff);
        --pg-code: var(--sl-color-bg-inline-code, #fff);
        --pg-accent: var(--sl-color-accent, var(--teal, #0f6e7a));
        --pg-on-accent: var(--sl-color-black, #fff);
        --pg-mono: var(--sl-font-mono, 'JetBrains Mono', ui-monospace, monospace);
        --pg-sm: var(--sl-text-sm, 0.875rem);
        --pg-xs: var(--sl-text-xs, 0.8125rem);
        --pg-base: var(--sl-text-base, 1rem);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1.5rem;
        color: var(--pg-text);
        text-align: left;
    }
    /* The gaps space the playground's parts, not Starlight's content flow, which spaces each from the one before. */
    .pg :global(*) {
        margin-top: 0;
    }
    .pg-examples {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .pg button {
        font: inherit;
        font-size: var(--pg-sm);
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        border: 1px solid var(--pg-border);
        background: var(--pg-button);
        color: var(--pg-text);
        cursor: pointer;
    }
    .pg button:hover:not(:disabled) {
        border-color: var(--pg-accent);
    }
    .pg button:disabled {
        opacity: 0.6;
        cursor: default;
    }
    .pg .pg-run {
        background: var(--pg-accent);
        border-color: var(--pg-accent);
        color: var(--pg-on-accent);
        font-weight: 600;
    }
    .pg-label {
        font-size: var(--pg-sm);
        color: var(--pg-label);
    }
    .pg-cypher {
        width: 100%;
        box-sizing: border-box;
        font-family: var(--pg-mono);
        font-size: var(--pg-sm);
        line-height: 1.5;
        padding: 0.75rem;
        border-radius: 0.5rem;
        border: 1px solid var(--pg-border);
        background: var(--pg-code);
        color: var(--pg-text);
        resize: vertical;
    }
    .pg-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .pg-status {
        font-size: var(--pg-sm);
        color: var(--pg-muted);
    }
    .pg-panes {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
    }
    @media (max-width: 50rem) {
        .pg-panes {
            grid-template-columns: minmax(0, 1fr);
        }
    }
    .pg-pane {
        min-width: 0;
    }
    .pg .pg-pane-title {
        font-size: var(--pg-base);
        line-height: 1.4;
        letter-spacing: normal;
        margin: 0 0 0.5rem;
    }
    .pg-results {
        overflow-x: auto;
    }
    /* Global: the script makes the results, so they don't carry this component's scope. */
    .pg-results :global(table) {
        margin: 0;
        font-size: var(--pg-sm);
        border-collapse: collapse;
    }
    .pg-results :global(th),
    .pg-results :global(td) {
        text-align: left;
        vertical-align: top;
        padding: 0.35rem 0.6rem;
        border-bottom: 1px solid var(--pg-border);
    }
    .pg-results :global(td) {
        font-family: var(--pg-mono);
        white-space: pre-wrap;
    }
    .pg-sql {
        margin: 0;
        max-height: 28rem;
        overflow: auto;
        font-size: var(--pg-xs);
        white-space: pre-wrap;
        word-break: break-word;
        padding: 0.75rem;
        border-radius: 0.5rem;
        border: 1px solid var(--pg-border);
        background: var(--pg-code);
    }
    .pg-results :global(.pg-error) {
        color: var(--sl-color-red-high, #b3261e);
        font-family: var(--pg-mono);
        font-size: var(--pg-sm);
        white-space: pre-wrap;
    }
    .pg-results :global(.pg-empty) {
        color: var(--pg-muted);
    }
</style>
