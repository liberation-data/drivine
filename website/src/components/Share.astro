---
/**
 * Share buttons: X, LinkedIn and Bluesky (each opens its own compose page in a new tab), and Copy link. The icons are
 * embabel-hub's, as on worlds.embabel.com.
 *
 * `url` is what is shared, the page's own address without its #fragment if none is given; `text` goes with it where the
 * service takes some (the page's title if none). A row's `data-share-url` may be changed later: dispatch `share:update`
 * on the row and its links follow. `tone` is `light` for a light
 * background, `dark` for a dark one, `docs` for the docs' own colours in either theme; `icons` drops the label, for
 * beside a heading.
 */
interface Props {
    url?: string;
    text?: string;
    label?: string;
    tone?: 'light' | 'dark' | 'docs';
    icons?: boolean;
    class?: string;
}
const { url = '', text = '', label = 'Share', tone = 'light', icons = false, class: className = '' } = Astro.props;
---
<div class:list={['share', `share-${tone}`, { 'share-icons': icons }, className]} data-share-url={url} data-share-text={text}>
    {!icons && <span class="share-label">{label}</span>}
    <a data-share-to="x" href="https://x.com/" target="_blank" rel="noopener noreferrer" title="Share on X" aria-label="Share on X">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
    </a>
    <a data-share-to="linkedin" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer" title="Share on LinkedIn" aria-label="Share on LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
    </a>
    <a data-share-to="bluesky" href="https://bsky.app/" target="_blank" rel="noopener noreferrer" title="Share on Bluesky" aria-label="Share on Bluesky">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.6 3.496 6.158 3.16-3.854.593-7.238 2.058-2.988 7.166 4.684 4.838 6.457-.09 7.206-2.828.749 2.739 2.521 7.666 7.206 2.828 4.25-5.108.866-6.573-2.988-7.166 2.558.336 5.373-.533 6.158-3.16.246-.828.624-5.789.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C14.046 4.747 11.087 8.686 12 10.8z" /></svg>
    </a>
    <button type="button" data-share-copy title="Copy link" aria-label="Copy link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /></svg>
    </button>
    <span class="share-said" role="status" aria-live="polite"></span>
</div>

<style>
    .share { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .share-label { margin-right: 4px; font-size: 14px; }
    .share a, .share button { display: inline-grid; place-items: center; width: 34px; height: 34px; padding: 0; border-radius: 999px; border: 1px solid; background: transparent; cursor: pointer; transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease; }
    .share svg { width: 15px; height: 15px; }
    .share-light .share-label { color: #3e5a64; }
    .share-light a, .share-light button { color: #0f6e7a; border-color: rgba(15, 110, 122, 0.3); }
    .share-light a:hover, .share-light button:hover, .share-light a:focus-visible, .share-light button:focus-visible { border-color: #0f6e7a; background: rgba(15, 110, 122, 0.08); }
    .share-dark .share-label { color: #cfe3e7; }
    .share-dark a, .share-dark button { color: #e6f1f3; border-color: rgba(255, 255, 255, 0.3); background: rgba(2, 28, 38, 0.55); }
    .share-dark a:hover, .share-dark button:hover, .share-dark a:focus-visible, .share-dark button:focus-visible { border-color: #f08a5d; background: rgba(240, 138, 93, 0.25); }
    .share-docs a, .share-docs button { color: var(--sl-color-gray-3); border-color: var(--sl-color-gray-5); }
    .share-docs a:hover, .share-docs button:hover, .share-docs a:focus-visible, .share-docs button:focus-visible { color: var(--sl-color-text-accent); border-color: var(--sl-color-text-accent); }
    .share-docs .share-said { color: var(--sl-color-gray-3); }
    .share-icons a, .share-icons button { width: 30px; height: 30px; border-color: transparent; }
    .share-icons svg { width: 14px; height: 14px; }
    .share-said { font-size: 13px; margin-left: 4px; }
    .share-light .share-said { color: #3e5a64; }
    .share-dark .share-said { color: #cfe3e7; }
    /* Out of the row while empty, but never display: none, which takes a live region out of the accessibility tree, so
       a screen reader would not say "Link copied". */
    .share-said:empty { position: absolute; margin: 0; }
</style>

<script>
    /* Each row's links, from its address and words; again whenever a row's address changes (share:update). */
    const compose: Record<string, (url: string, text: string) => string> = {
        x: (url, text) => `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`,
        linkedin: (url) => `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
        bluesky: (url, text) => `https://bsky.app/intent/compose?text=${encodeURIComponent(`${text} ${url}`)}`,
    };
    const own = () => `${location.origin}${location.pathname}${location.search}`;
    const wire = (row: HTMLElement) => {
        const url = row.dataset.shareUrl || own();
        const text = row.dataset.shareText || document.title;
        row.querySelectorAll<HTMLAnchorElement>('[data-share-to]').forEach((a) => (a.href = compose[a.dataset.shareTo!](url, text)));
    };
    document.querySelectorAll<HTMLElement>('.share').forEach((row) => {
        wire(row);
        row.addEventListener('share:update', () => wire(row));
    });
    /* Copy link, for anywhere the three don't reach: a chat, an email, Discord. */
    document.addEventListener('click', async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-share-copy]');
        if (!button) return;
        const row = button.closest<HTMLElement>('.share')!;
        const said = row.querySelector('.share-said')!;
        try {
            await navigator.clipboard.writeText(row.dataset.shareUrl || own());
            said.textContent = 'Link copied';
        } catch {
            said.textContent = 'Copy the address bar instead';
        }
        setTimeout(() => (said.textContent = ''), 2500);
    });
</script>
