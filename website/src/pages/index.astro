---
/**
 * The landing page: the old site's splash, then a door into each library's docs. The docs themselves are Starlight's,
 * generated from the two READMEs.
 */
import { getImage } from 'astro:assets';
import '@fontsource/ubuntu/latin-400.css';
import '@fontsource/ubuntu/latin-500.css';
import '@fontsource/ubuntu/latin-700.css';
import '@fontsource/noto-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import headingFont from '@fontsource/ubuntu/files/ubuntu-latin-700-normal.woff2?url';
import ocean from '../assets/hero-ocean.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The hero photo as AVIF and WebP, the JPEG as a fallback, and smaller for phones.
const photo = async (width: number): Promise<string> => {
    const [avif, webp, jpeg] = await Promise.all(
        (['avif', 'webp', 'jpeg'] as const).map((format) => getImage({ src: ocean, format, width, quality: format === 'avif' ? 55 : 70 }))
    );
    return `image-set(url('${avif.src}') type('image/avif'), url('${webp.src}') type('image/webp'), url('${jpeg.src}') type('image/jpeg'))`;
};
const photoVars = `--photo: ${await photo(1920)}; --photo-small: ${await photo(960)};`;
const ts = `${base}ts/`;
const jvm = `${base}jvm/`;
const image = (name: string) => `${base}images/${name}`;

import { REPOS, formatStars, repoUrl, stars } from '../lib/github';
const tsStars = await stars('ts');
const jvmStars = await stars('jvm');
const starLabel = (count: number | undefined) => (count === undefined ? '' : formatStars(count));

// The same view in each language, highlighted by hand: the panel switches between them.
const tsSample = `<span class="a">@NodeFragment</span>({ labels: [<span class="s">'Person'</span>] })
<span class="k">export class</span> <span class="t">Person</span> {
    <span class="a">@NodeId</span>() uuid: <span class="t">string</span>;
    name: <span class="t">string</span>;
    bio?: <span class="t">string</span>;
}

<span class="a">@GraphView</span>()
<span class="k">export class</span> <span class="t">PersonCareer</span> {
    <span class="a">@Root</span>() person: <span class="t">Person</span>;

    <span class="a">@GraphRelationship</span>({ type: <span class="s">'WORKS_FOR'</span>, target: () =&gt; <span class="t">WorkHistory</span> })
    employmentHistory: <span class="t">WorkHistory</span>[] = [];
}

<span class="c">// Everyone whose bio mentions leading</span>
<span class="k">const</span> leads = <span class="k">await</span> gom.loadAll(<span class="t">PersonCareer</span>, (q) =&gt; ({
    where: q.person.bio.contains(<span class="s">'Lead'</span>)
}));`;
const ktSample = `<span class="a">@NodeFragment</span>(labels = [<span class="s">"Person"</span>])
<span class="k">data class</span> <span class="t">Person</span>(
    <span class="a">@NodeId</span> <span class="k">val</span> uuid: <span class="t">String</span>,
    <span class="k">val</span> name: <span class="t">String</span>,
    <span class="k">val</span> bio: <span class="t">String</span>?
)

<span class="a">@GraphView</span>
<span class="k">data class</span> <span class="t">PersonCareer</span>(
    <span class="a">@Root</span> <span class="k">val</span> person: <span class="t">Person</span>,

    <span class="a">@GraphRelationship</span>(type = <span class="s">"WORKS_FOR"</span>)
    <span class="k">val</span> employmentHistory: <span class="t">List</span>&lt;<span class="t">WorkHistory</span>&gt;
)

<span class="c">// Everyone whose bio mentions leading</span>
<span class="k">val</span> leads = graphObjectManager.loadAll&lt;<span class="t">PersonCareer</span>&gt; {
    where {
        person.bio contains <span class="s">"Lead"</span>
    }
}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Drivine: graph database client for TypeScript and the JVM</title>
        <meta name="description" content="Drivine is a graph database client for TypeScript and the JVM: Neo4j, Memgraph, FalkorDB and Oracle." />
        <link rel="icon" href={`${base}favicon.ico`} />
        <!-- The heading's font, which the largest paint (DRIVINE) waits for. -->
        <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
        <style is:global>
            /* Relative to this file, so the build rewrites it wherever the stylesheet ends up. --photo and
               --photo-small, in AVIF, WebP and JPEG, are set on <body> from the frontmatter. */
            :root {
                --lines: url('../assets/lines.png');
                --abyss: #021c26;
                --ink: #0b2530;
                --muted: #3e5a64;
                --teal: #0f6e7a;
                --paper: #f6f9f9;
                --line: #d5e3e6;
                --accent: #f08a5d;
            }
            * { box-sizing: border-box; }
            body { margin: 0; font-family: Ubuntu, 'Segoe UI', sans-serif; color: var(--ink); background: var(--paper); }
            a { color: var(--teal); }
            a:hover { color: #0a4e57; }
            code, pre { font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-ligatures: none; }
            .wrap { max-width: 1200px; margin: 0 auto; }
            .eyebrow { margin: 0; font-weight: 700; font-size: 14px; letter-spacing: 0.22em; color: var(--teal); }
            h2 { margin: 0; font-weight: 700; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.15; }

            .water { position: relative; overflow: hidden; color: #fff; }
            .water::before, .water::after { content: ''; position: absolute; inset: 0; }
            .water::before { background: linear-gradient(rgba(1, 65, 78, 0.55), rgba(1, 65, 78, 0.55)), var(--photo) center 38% / cover; }
            .water::after { background: var(--lines); opacity: 0.55; }
            .water > * { position: relative; z-index: 1; }
            /* Above the splash that follows it, so the GitHub menu opens over it and takes clicks. */
            .water > .nav { z-index: 3; }
            @media (max-width: 800px) {
                .water::before { background-image: linear-gradient(rgba(1, 65, 78, 0.55), rgba(1, 65, 78, 0.55)), var(--photo-small); }
                .start.water::before { background-image: linear-gradient(rgba(1, 65, 78, 0.82), rgba(1, 65, 78, 0.82)), var(--photo-small); }
            }

            .hero { min-height: 760px; display: flex; flex-direction: column; }
            .nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; width: 100%; padding: 24px 32px; }
            .nav a { color: #e6f2f4; text-decoration: none; }
            .nav a:hover { color: #fff; text-decoration: underline; }
            .brand { display: flex; align-items: center; gap: 12px; font-weight: 700; letter-spacing: 0.12em; font-size: 18px; }
            .nav-links { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; font-size: 16px; }
            .repo-menu { position: relative; }
            .repo-menu summary { cursor: pointer; list-style: none; color: #e6f2f4; }
            .repo-menu summary::-webkit-details-marker { display: none; }
            .repo-menu summary::after { content: ' ▾'; font-size: 0.8em; }
            .repo-menu summary:hover { color: #fff; text-decoration: underline; }
            .repo-menu .menu { position: absolute; right: 0; top: calc(100% + 10px); z-index: 5; min-width: 300px; display: flex; flex-direction: column; padding: 6px; border-radius: 12px; background: #04222c; border: 1px solid rgba(255, 255, 255, 0.18); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35); }
            .repo-menu .menu a { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 44px; padding: 8px 12px; border-radius: 8px; color: #cfe3e7; }
            .repo-menu .menu a:hover { background: rgba(255, 255, 255, 0.08); color: #fff; text-decoration: none; }
            .repo-menu .menu strong { color: #fff; margin-right: 6px; }
            .repo-menu .hint { margin: 4px 12px 6px; font-size: 13px; color: #9db8bf; }
            .repo-menu .count { font-size: 14px; font-weight: 700; color: #fff; white-space: nowrap; }
            .splash { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px 24px 96px; }
            .emblem { width: 132px; height: 132px; border: 3px solid #fff; border-radius: 50%; display: grid; place-items: center; }
            .emblem > div { width: 112px; height: 112px; border: 2px dotted rgba(255, 255, 255, 0.85); border-radius: 50%; display: grid; place-items: center; }
            .rule { height: 2px; background: rgba(255, 255, 255, 0.9); }
            .splash h1 { margin: 14px 0 10px; font-weight: 700; font-size: clamp(56px, 9vw, 112px); line-height: 1; letter-spacing: 0.05em; text-shadow: 0 2px 18px rgba(0, 30, 40, 0.45); }
            .subtitle { margin: 22px 0 8px; font-weight: 500; font-size: clamp(20px, 2.6vw, 34px); letter-spacing: 0.06em; text-transform: uppercase; text-shadow: 0 2px 12px rgba(0, 30, 40, 0.5); }
            .tagline { margin: 0; font-family: 'Noto Serif', Georgia, serif; font-style: italic; font-size: clamp(18px, 2vw, 26px); color: #eaf4f6; }
            .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
            .button { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 26px; border-radius: 10px; font-weight: 700; font-size: 17px; text-decoration: none; }
            .button.primary { background: var(--accent); color: var(--ink); }
            .button.primary:hover { color: var(--ink); filter: brightness(1.06); }
            .button.ghost { border: 2px solid #fff; color: #fff; }
            .button.ghost:hover { color: #fff; background: rgba(255, 255, 255, 0.12); }
            .installs { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 22px; font-size: 14px; }
            .installs code { background: rgba(2, 28, 38, 0.62); border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 8px; padding: 9px 14px; color: #e6f2f4; }

            .intro { padding: 96px 32px 72px; }
            .intro .wrap { max-width: 880px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
            .intro p:last-child { margin: 0; font-size: 19px; line-height: 1.65; color: var(--muted); max-width: 720px; }

            .libraries { padding: 0 32px 96px; }
            .row { display: flex; flex-wrap: wrap; gap: 28px; }
            .card { flex: 1 1 380px; min-width: 0; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 36px; display: flex; flex-direction: column; gap: 16px; }
            .card h3 { margin: 0; font-size: 32px; font-weight: 700; }
            .card p { margin: 0; font-size: 17px; line-height: 1.6; color: var(--muted); }
            .card .eyebrow { letter-spacing: 0.14em; }
            .card > code { font-size: 14px; background: #eef5f6; border-radius: 8px; padding: 12px 14px; overflow-x: auto; }
            .card .links { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: auto; padding-top: 8px; font-size: 16px; font-weight: 500; }
            .card .star { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; padding: 4px 4px 4px 12px; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); }
            .card .star:hover { border-color: var(--teal); color: var(--ink); }
            .card .star span { font-size: 14px; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: #eef5f6; }
            .shared { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 14px; text-align: center; margin-top: 28px; padding: 22px 28px; border-radius: 14px; background: #e3eff1; color: #123a45; font-size: 17px; line-height: 1.5; }

            .compose { background: var(--abyss); color: #e6f2f4; padding: 96px 32px; }
            .compose .wrap { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }
            .compose .text { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
            .compose .eyebrow { color: #7fd3c8; }
            .compose h2 { color: #fff; }
            .compose .text > p:not(.eyebrow) { margin: 0; font-size: 18px; line-height: 1.65; color: #bfd5da; }
            .compose ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; font-size: 17px; line-height: 1.5; color: #d7e6e9; }
            .compose li { display: flex; gap: 12px; }
            .compose li::before { content: '—'; color: var(--accent); font-weight: 700; }
            .compose li code { font-size: 15px; color: #fff; }
            .panel { flex: 1.4 1 520px; min-width: 0; background: #071e27; border: 1px solid #1c3d48; border-radius: 16px; overflow: hidden; }
            .tabs { display: flex; gap: 4px; padding: 10px 12px; border-bottom: 1px solid #1c3d48; background: #0a2630; }
            .tabs button { min-height: 44px; padding: 0 18px; border-radius: 8px; border: 0; cursor: pointer; font: 500 15px Ubuntu, sans-serif; background: transparent; color: #9db8bf; }
            .tabs button[aria-pressed='true'] { background: #1c4652; color: #fff; }
            .panel pre { margin: 0; padding: 24px 26px; font-size: 14.5px; line-height: 1.65; color: #d7e4e7; overflow-x: auto; }
            .panel pre[hidden] { display: none; }
            .a { color: #7fd3c8; } .k { color: #f4a27c; } .s { color: #c8de8c; } .t { color: #9cc4f2; } .c { color: #8ba3aa; }

            .features { padding: 96px 32px; }
            .features .wrap { display: flex; flex-direction: column; gap: 44px; }
            .features header { display: flex; flex-direction: column; gap: 14px; max-width: 720px; }
            .feature { flex: 1 1 320px; min-width: 0; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 12px; }
            .feature::before { content: ''; width: 32px; height: 4px; border-radius: 2px; background: var(--accent); }
            .feature h3 { margin: 0; font-size: 21px; font-weight: 700; }
            .feature p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--muted); }
            .feature code { font-size: 14px; }
            .features .row { gap: 24px; }

            .perf { padding: 0 32px 96px; }
            .perf .wrap { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; background: #e3eff1; border-radius: 16px; padding: 48px; }
            .perf .text { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
            .perf .text > p:not(.eyebrow) { margin: 0; font-size: 17px; line-height: 1.65; color: #123a45; }
            .perf .stats { flex: 1 1 300px; min-width: 0; margin: 0; display: grid; gap: 14px; }
            .perf .stats div { background: #fff; border-radius: 12px; padding: 18px 22px; }
            .perf dt { font-size: 30px; font-weight: 700; color: var(--ink); }
            .perf dd { margin: 4px 0 0; font-size: 15px; line-height: 1.5; color: var(--muted); }
            @media (max-width: 600px) { .perf .wrap { padding: 28px 22px; gap: 28px; } }

            .backing { padding: 0 32px 72px; }
            .backing p { margin: 0 auto; max-width: 880px; text-align: center; font-size: 19px; line-height: 1.6; color: #123a45; padding: 26px 32px; border-radius: 14px; background: #e3eff1; }
            .engines { padding: 0 32px 96px; }
            .engines .wrap { display: flex; flex-direction: column; gap: 22px; align-items: center; text-align: center; }
            .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
            .chips span { border: 1px solid #b9d0d5; border-radius: 999px; padding: 10px 20px; font-size: 17px; font-weight: 500; background: #fff; }
            .chips span.via { border-style: dashed; background: transparent; color: var(--muted); }
            .engines p { margin: 0; font-size: 15px; color: #4a6670; }

            .start .wrap { max-width: 880px; padding: 88px 32px; display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; }
            .start.water::before { background: linear-gradient(rgba(1, 65, 78, 0.82), rgba(1, 65, 78, 0.82)), var(--photo) center 38% / cover; }
            .start p { margin: 0; font-size: 18px; line-height: 1.6; color: #e1eef1; }

            footer { background: var(--abyss); color: #cfe3e7; padding: 56px 32px; }
            footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px; }
            footer .about { flex: 1 1 320px; min-width: 0; display: flex; gap: 16px; align-items: flex-start; }
            footer .about p { margin: 0; font-size: 15px; line-height: 1.6; }
            footer nav { display: flex; flex-wrap: wrap; gap: 48px; font-size: 15px; }
            footer nav div { display: flex; flex-direction: column; gap: 10px; }
            footer nav span { font-weight: 700; color: #fff; }
            footer a { color: #cfe3e7; text-decoration: none; }
            footer a:hover { color: #fff; text-decoration: underline; }
        </style>
    </head>
    <body style={photoVars}>
        <header class="water hero">
            <nav class="nav wrap" aria-label="Main">
                <a href={base} class="brand"><img src={image('cow-emblem.png')} alt="" width="36" height="36" /><span>DRIVINE</span></a>
                <div class="nav-links">
                    <a href={ts}>TypeScript docs</a>
                    <a href={jvm}>Kotlin &amp; Java docs</a>
                    <details class="repo-menu">
                        <summary>GitHub</summary>
                        <div class="menu">
                            <a href={repoUrl('ts')}>
                                <span><strong>{REPOS.ts.name}</strong> {REPOS.ts.language}</span>
                                {tsStars !== undefined && <span class="count">★ {starLabel(tsStars)}</span>}
                            </a>
                            <a href={repoUrl('jvm')}>
                                <span><strong>{REPOS.jvm.name}</strong> {REPOS.jvm.language}</span>
                                {jvmStars !== undefined && <span class="count">★ {starLabel(jvmStars)}</span>}
                            </a>
                            <p class="hint">★ Star them on GitHub: it helps others find Drivine.</p>
                        </div>
                    </details>
                </div>
            </nav>
            <div class="splash">
                <div class="emblem"><div><img src={image('cow-emblem.png')} alt="The Drivine cow" width="76" height="76" /></div></div>
                <div class="rule" style="width: min(760px, 86%); margin-top: 32px" aria-hidden="true"></div>
                <h1>DRIVINE</h1>
                <div class="rule" style="width: min(900px, 94%)" aria-hidden="true"></div>
                <p class="subtitle">Graph database client for TypeScript &amp; the JVM</p>
                <p class="tagline">Community project by Liberation Data.</p>
                <div class="actions" style="margin-top: 44px">
                    <a href={ts} class="button primary">TypeScript docs <span aria-hidden="true">→</span></a>
                    <a href={jvm} class="button ghost">Kotlin &amp; Java docs <span aria-hidden="true">→</span></a>
                </div>
                <div class="installs">
                    <code>npm install @liberation-data/drivine</code>
                    <code>org.drivine:drivine4j</code>
                </div>
            </div>
        </header>

        <main>
            <section class="intro">
                <div class="wrap">
                    <p class="eyebrow">THE DIVINE DRIVER</p>
                    <h2>Get ready! You’re about to obtain supernatural graph database powers.</h2>
                    <p>
                        Drivine maps graphs to objects by composition. Declare the view a use case needs, made of node fragments
                        and the relationships between them, and Drivine writes the statement. When you would rather write the
                        Cypher yourself, the persistence manager is still there.
                    </p>
                </div>
            </section>

            <section class="libraries">
                <div class="wrap">
                    <div class="row">
                        <article class="card">
                            <p class="eyebrow">TYPESCRIPT · NODE.JS</p>
                            <h3>Drivine</h3>
                            <p>
                                Built on NestJS. Decorated classes, a typed query DSL whose references come from the classes
                                themselves, and injection with <code>@InjectGraphObjectManager</code>.
                            </p>
                            <code>npm install @liberation-data/drivine</code>
                            <div class="links">
                                <a href={ts}>Read the docs →</a>
                                <a href={repoUrl('ts')} class="star">★ Star on GitHub{tsStars !== undefined && <span>{starLabel(tsStars)}</span>}</a>
                                <a href="https://www.npmjs.com/package/@liberation-data/drivine">npm</a>
                            </div>
                        </article>
                        <article class="card">
                            <p class="eyebrow">KOTLIN · JAVA · SPRING BOOT</p>
                            <h3>drivine4j</h3>
                            <p>
                                The graph client for Embabel. Annotated models in Kotlin or Java, a DSL generated by KSP, and Spring
                                Boot auto-configuration with test containers built in.
                            </p>
                            <code>implementation("org.drivine:drivine4j:&lt;version&gt;")</code>
                            <div class="links">
                                <a href={jvm}>Read the docs →</a>
                                <a href={repoUrl('jvm')} class="star">★ Star on GitHub{jvmStars !== undefined && <span>{starLabel(jvmStars)}</span>}</a>
                                <a href="https://central.sonatype.com/artifact/org.drivine/drivine4j">Maven Central</a>
                            </div>
                        </article>
                    </div>
                    <p class="shared">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#0F6E7A" stroke-width="2" aria-hidden="true">
                            <circle cx="7" cy="14" r="4"></circle><circle cx="21" cy="7" r="4"></circle><circle cx="21" cy="21" r="4"></circle>
                            <path d="M10.5 12.2 17.5 8.8M10.5 15.8l7 3.4"></path>
                        </svg>
                        <span><strong>One storage format.</strong> A store written from Node is read, stamped and checked alike from the JVM, and the other way round.</span>
                    </p>
                </div>
            </section>

            <section class="compose">
                <div class="wrap">
                    <div class="text">
                        <p class="eyebrow">COMPOSITION OVER INHERITANCE</p>
                        <h2>Compose views, not models.</h2>
                        <p>A person can play many roles. Rather than one model that serves every use case, declare a view for each, and load it in a single statement.</p>
                        <ul>
                            <li><span><code>@NodeFragment</code> maps one node.</span></li>
                            <li><span><code>@GraphView</code> composes fragments and relationships from a <code>@Root</code>.</span></li>
                            <li><span>The DSL’s references come from your classes, or from code KSP generates.</span></li>
                        </ul>
                    </div>
                    <div class="panel">
                        <div class="tabs" role="group" aria-label="Language">
                            <button type="button" aria-pressed="true" data-lang="ts">TypeScript</button>
                            <button type="button" aria-pressed="false" data-lang="kt">Kotlin</button>
                        </div>
<pre data-lang="ts" set:html={tsSample} />
<pre data-lang="kt" hidden set:html={ktSample} />
                    </div>
                </div>
            </section>

            <section class="features">
                <div class="wrap">
                    <header>
                        <p class="eyebrow">IN BOTH LIBRARIES</p>
                        <h2>Everything an object manager should do, and the Cypher when you want it.</h2>
                    </header>
                    <div class="row">
                        <article class="feature"><h3>A typed query DSL</h3><p>Filters, ordering, keyset paging and index advice, accepted by loads, counts, deletes, patches and grouped reads.</p></article>
                        <article class="feature"><h3>Saves, patches and edges</h3><p>save and saveAll with null policies and replace modes, update, create, patch, cascading deletes, relate and unrelate.</p></article>
                        <article class="feature"><h3>Optimistic locking</h3><p><code>@NodeStamp</code> refuses a save when the node changed since it was loaded, in a stamp format Node and the JVM share.</p></article>
                        <article class="feature"><h3>Vector and full-text search</h3><p>loadNearest and loadMatching on views and fragments, with one score scale on every engine.</p></article>
                        <article class="feature"><h3>Schema management</h3><p>Range, uniqueness, vector and full-text indexes declared on your classes, enforced at startup, with drift detection.</p></article>
                        <article class="feature"><h3>Test containers, or yours</h3><p>A container for each datasource in CI. While you iterate, <code>USE_LOCAL_NEO4J=true</code> points tests at your own instance.</p></article>
                    </div>
                </div>
            </section>

            <section class="perf">
                <div class="wrap">
                    <div class="text">
                        <p class="eyebrow">PERFORMANCE</p>
                        <h2>One statement, one round trip.</h2>
                        <p>
                            Drivine is built to be fast. There's no lazy loading, no session cache to keep warm and no query
                            for each relationship. A view, with everything related to it, loads in one statement, and a save
                            is one statement too.
                        </p>
                        <p>
                            <a href="https://github.com/liberation-data/graph-bench">Graph Bench</a> uses drivine4j to compare
                            Neo4j, FalkorDB and Oracle on a graph of 1.1 million nodes and 4.5 million relationships, with the
                            same Kotlin on each.
                        </p>
                    </div>
                    <dl class="stats">
                        <div><dt>1.5–3.5 ms</dt><dd>to load an issue with its repo, author, assignees, topics and comments, on every engine</dd></div>
                        <div><dt>1</dt><dd>statement for each load or save, however many relationships it has</dd></div>
                    </dl>
                </div>
            </section>

