---
/**
 * The Cypher playground's own page, which the landing page's "Try it in your browser" opens. The playground itself is
 * src/components/Playground.astro, its engine started as the page loads.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Playground from '../components/Playground.astro';
import StudioPanel from '../components/StudioPanel.astro';
---

<StarlightPage
    hasSidebar={false}
    frontmatter={{
        title: 'Cypher playground',
        description: 'Run Cypher on SQLite in your browser with Drivine, and see the SQL it compiles to.',
        tableOfContents: false
    }}
>
    <p>
        Cypher, compiled to SQL by Drivine and run on SQLite, all in this page: nothing is sent to a server. The graph is a
        few films and the people who made them. Pick an example or write your own, then <strong>Run</strong> (or press
        Ctrl+Enter). <strong>Reset</strong> puts the graph back as it started.
    </p>

    <Playground />
    <StudioPanel />
</StarlightPage>
