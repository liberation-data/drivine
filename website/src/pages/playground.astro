---
/**
 * The Cypher playground: Drivine for TypeScript running in the page, on SQLite's wasm build, with a small movies graph.
 * A query is compiled to SQL by the shared Cypher compiler and run on SQLite, in the browser, with nothing sent to a
 * server. The engine is public/playground/engine.mjs, bundled by scripts/bundle-playground.mjs.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { EXAMPLES } from '../playground/movies';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage
    frontmatter={{
        title: 'Cypher playground',
        description: 'Run Cypher on SQLite in your browser with Drivine, and see the SQL it compiles to.',
        tableOfContents: false
    }}
>
    <p>
        Cypher, compiled to SQL by Drivine and run on SQLite, all in this page: nothing is sent to a server. The graph is a
        few films and the people who made them. Pick an example or write your own, then <strong>Run</strong> (or press
        Ctrl+Enter). <strong>Reset</strong> puts the graph back as it started.
    </p>

    <div class="pg" data-engine={`${base}playground/engine.mjs`}>
        <div class="pg-examples" role="group" aria-label="Example queries">
            {
                EXAMPLES.map((example, i) => (
                    <button type="button" class="pg-example" data-index={i}>
                        {example.label}
                    </button>
                ))
            }
        </div>
        <label class="pg-label" for="pg-cypher">Cypher</label>
        <textarea id="pg-cypher" class="pg-cypher" rows="7" spellcheck="false" autocapitalize="off">{EXAMPLES[0].cypher}</textarea>
        <div class="pg-actions">
            <button type="button" class="pg-run" disabled>Loading…</button>
            <button type="button" class="pg-reset" disabled>Reset</button>
            <span class="pg-status" role="status" aria-live="polite"></span>
        </div>
        <div class="pg-panes">
            <section class="pg-pane" aria-labelledby="pg-results-title">
                <h2 id="pg-results-title" class="pg-pane-title">Results</h2>
                <div class="pg-results"></div>
            </section>
            <section class="pg-pane" aria-labelledby="pg-sql-title">
                <h2 id="pg-sql-title" class="pg-pane-title">Compiled SQL (SQLite)</h2>
                <pre class="pg-sql"><code></code></pre>
            </section>
        </div>
    </div>
    <script type="application/json" id="pg-examples" set:html={JSON.stringify(EXAMPLES.map((e) => e.cypher))} />
</StarlightPage>

<script>
    type Outcome = { rows?: Record<string, unknown>[]; sql?: string; error?: string; millis: number };
    type Playground = { run(cypher: string): Promise<Outcome>; reset(): Promise<void> };

    const root = document.querySelector<HTMLElement>('.pg')!;
    const cypher = root.querySelector<HTMLTextAreaElement>('.pg-cypher')!;
    const runButton = root.querySelector<HTMLButtonElement>('.pg-run')!;
    const resetButton = root.querySelector<HTMLButtonElement>('.pg-reset')!;
    const status = root.querySelector<HTMLElement>('.pg-status')!;
    const results = root.querySelector<HTMLElement>('.pg-results')!;
    const sql = root.querySelector<HTMLElement>('.pg-sql code')!;
    const examples: string[] = JSON.parse(document.getElementById('pg-examples')!.textContent ?? '[]');

    /** A value as a cell shows it: text as it is, anything else as JSON. */
    function shown(value: unknown): string {
        if (typeof value === 'string') return value;
        return JSON.stringify(value, (_key, v) => (typeof v === 'bigint' ? v.toString() : v)) ?? 'null';
    }

    /** The rows as a table, a column for each of their columns. */
    function table(rows: Record<string, unknown>[]): HTMLElement {
        if (rows.length === 0) {
            const empty = document.createElement('p');
            empty.className = 'pg-empty';
            empty.textContent = 'No rows.';
            return empty;
        }
        const columns = [...new Set(rows.flatMap((row) => Object.keys(row)))];
        const element = document.createElement('table');
        const head = element.createTHead().insertRow();
        for (const column of columns) {
            const th = document.createElement('th');
            th.textContent = column;
            head.appendChild(th);
        }
        const body = element.createTBody();
        for (const row of rows) {
            const tr = body.insertRow();
            for (const column of columns) {
                tr.insertCell().textContent = shown(row[column]);
            }
        }
        return element;
    }

    function show(outcome: Outcome): void {
        sql.textContent = outcome.sql ?? '';
        results.replaceChildren();
        if (outcome.error !== undefined) {
            const error = document.createElement('p');
            error.className = 'pg-error';
            error.textContent = outcome.error;
            results.appendChild(error);
            status.textContent = outcome.sql ? 'Failed.' : 'Refused.';
            return;
        }
        const rows = outcome.rows ?? [];
        results.appendChild(table(rows));
        status.textContent = `${rows.length} ${rows.length === 1 ? 'row' : 'rows'} in ${outcome.millis.toFixed(1)} ms`;
    }

    async function main(): Promise<void> {
        let playground: Playground;
        try {
            const engine = await import(/* @vite-ignore */ root.dataset.engine!);
            playground = await engine.start();
        } catch (e) {
            runButton.textContent = 'Run';
            status.textContent = `The playground couldn't start: ${(e as Error)?.message ?? e}`;
            return;
        }
        let busy = false;
        const busyWhile = async (work: () => Promise<void>) => {
            if (busy) return;
            busy = true;
            runButton.disabled = resetButton.disabled = true;
            try {
                await work();
            } finally {
                busy = false;
                runButton.disabled = resetButton.disabled = false;
            }
        };
        const run = () => busyWhile(async () => show(await playground.run(cypher.value)));
        runButton.textContent = 'Run';
        runButton.addEventListener('click', run);
        resetButton.addEventListener('click', () =>
            busyWhile(async () => {
                await playground.reset();
                status.textContent = 'The graph is back as it started.';
            })
        );
        cypher.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
                event.preventDefault();
                run();
            }
        });
        root.querySelectorAll<HTMLButtonElement>('.pg-example').forEach((button) =>
            button.addEventListener('click', () => {
                cypher.value = examples[Number(button.dataset.index)];
                run();
            })
        );
        runButton.disabled = resetButton.disabled = false;
        status.textContent = 'Ready.';
        await run();
    }

    main();
</script>

<style>
    .pg {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }
    .pg-examples {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .pg button {
        font: inherit;
        font-size: var(--sl-text-sm);
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        border: 1px solid var(--sl-color-gray-5);
        background: var(--sl-color-bg-nav);
        color: var(--sl-color-text);
        cursor: pointer;
    }
    .pg button:hover:not(:disabled) {
        border-color: var(--sl-color-accent);
    }
    .pg button:disabled {
        opacity: 0.6;
        cursor: default;
    }
    .pg .pg-run {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        color: var(--sl-color-black);
        font-weight: 600;
    }
    .pg-label {
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-2);
    }
    .pg-cypher {
        width: 100%;
        box-sizing: border-box;
        font-family: var(--sl-font-mono);
        font-size: var(--sl-text-sm);
        line-height: 1.5;
        padding: 0.75rem;
        border-radius: 0.5rem;
        border: 1px solid var(--sl-color-gray-5);
        background: var(--sl-color-bg-inline-code);
        color: var(--sl-color-text);
        resize: vertical;
    }
    .pg-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .pg-status {
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }
    .pg-panes {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
    }
    @media (max-width: 50rem) {
        .pg-panes {
            grid-template-columns: minmax(0, 1fr);
        }
    }
    .pg-pane {
        min-width: 0;
    }
    .pg .pg-pane-title {
        font-size: var(--sl-text-base);
        margin: 0 0 0.5rem;
    }
    .pg-results {
        overflow-x: auto;
    }
    .pg-results table {
        margin: 0;
        font-size: var(--sl-text-sm);
    }
    .pg-results td {
        font-family: var(--sl-font-mono);
        white-space: pre-wrap;
    }
    .pg-sql {
        margin: 0;
        max-height: 28rem;
        overflow: auto;
        font-size: var(--sl-text-xs);
        white-space: pre-wrap;
        word-break: break-word;
    }
    .pg-error {
        color: var(--sl-color-red-high, #c00);
        font-family: var(--sl-font-mono);
        font-size: var(--sl-text-sm);
        white-space: pre-wrap;
    }
    .pg-empty {
        color: var(--sl-color-gray-3);
    }
</style>
